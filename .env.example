# Copy to .env and fill in. .env is gitignored; never commit it or paste it anywhere.

# ---- chain (Arc mainnet). The testnet is chain id 5042002, RPC https://rpc.testnet.arc.network
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
EXPLORER_URL=https://www.arcexplorer.org
BRIDGE_URL=https://cctpbridge.app/
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# ---- our contracts (the site, the API and the keeper read these)
FACTORY=
LENS=
PLATFORM_SINK=

# ---- keeper. Dry run unless KEEPER_EXECUTE=true. The key only pays gas: collectFees() is
# permissionless and pays nothing to the caller, so a small dedicated key is enough.
KEEPER_EXECUTE=false
KEEPER_PRIVATE_KEY=
KEEPER_MIN_COLLECT_WEI=1000000000000000
# floor in gwei; the actual price is read from the node with a 25% margin
KEEPER_GAS_PRICE_GWEI=21
CRON_SECRET=

# ---- wallet UI: Reown (WalletConnect) project id, public by nature
REOWN_PROJECT_ID=

# ---- deployment. A freshly generated key that has never appeared in a chat, screenshot or issue.
# Generate with `cast wallet new` and only ever read it from this file.
MAINNET_PRIVATE_KEY=
MAINNET_DEPLOYER=
# a throwaway key for rehearsals and test transactions
PRIVATE_KEY=

# ---- optional tooling
AICAP_BASE=
AICAP_TOKEN=
VERCEL_TOKEN=
